{
  "name": "droidpane",
  "productName": "DroidPane",
  "version": "1.0.0",
  "description": "Android 镜像、设备控制与录屏调试工具",
  "main": ".webpack/main",
  "private": true,
  "author": "DroidPane contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/asd116725/droidpane.git"
  },
  "homepage": "https://github.com/asd116725/droidpane#readme",
  "bugs": {
    "url": "https://github.com/asd116725/droidpane/issues"
  },
  "scripts": {
    "start": "node scripts/start.cjs",
    "package": "electron-forge package",
    "package:mac:x64": "electron-forge package --platform=darwin --arch=x64",
    "package:mac:arm64": "electron-forge package --platform=darwin --arch=arm64",
    "package:win:x64": "electron-forge package --platform=win32 --arch=x64",
    "make": "electron-forge make",
    "make:mac:x64": "electron-forge make --platform=darwin --arch=x64",
    "make:mac:arm64": "electron-forge make --platform=darwin --arch=arm64",
    "make:win:x64": "electron-forge make --platform=win32 --arch=x64",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "fetch:scrcpy": "node scripts/fetch-scrcpy.mjs",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.34.1",
    "antd": "^6.5.3",
    "mediabunny": "1.52.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-wix": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.17.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "css-loader": "^7.1.2",
    "electron": "43.2.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "node-loader": "^2.1.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  }
}
